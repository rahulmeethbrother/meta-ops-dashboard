# ---------------------------------------------------------------------------
# Client-side Firebase config (safe to expose; these are NOT secrets).
# From: Firebase console -> Project settings -> General -> Your apps -> Web app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Server-only (set in Vercel as encrypted environment variables; never
# prefixed with NEXT_PUBLIC_, never sent to the browser).
# ---------------------------------------------------------------------------

# Base64 of the service account JSON key (see docs/DEPLOYMENT.md step 3):
#   base64 -w0 sa-key.json
FIREBASE_SERVICE_ACCOUNT_B64=

# GCP project id (defaults to the service account's project if empty).
GCP_PROJECT=

# Cloud Storage bucket where the renderer uploads finished videos.
OUTPUT_BUCKET=your-project.firebasestorage.app

# Cloud Tasks queue that feeds the renderer.
TASKS_LOCATION=us-central1
TASKS_QUEUE=render-queue

# Cloud Run renderer URL (from `gcloud run deploy` output).
RENDERER_URL=https://mpt-renderer-xxxxxxxx-uc.a.run.app

# Service account email used as the OIDC identity for Cloud Tasks -> Cloud Run.
TASKS_INVOKER_SA=mpt-invoker@your-project.iam.gserviceaccount.com

# Prefix for Secret Manager secret ids (must match the renderer).
SECRET_PREFIX=mpt

# Per-user limits.
MAX_ITEMS_PER_JOB=20
MAX_ACTIVE_ITEMS=10
MAX_ITEMS_PER_HOUR=30

# ---------------------------------------------------------------------------
# Company Studio (server-only). The gateway must be reachable from the web
# server runtime. Never prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
COMPANY_STUDIO_GATEWAY_URL=http://127.0.0.1:8787
COMPANY_STUDIO_GATEWAY_TOKEN=

# Password protecting the public Meta Ops dashboard and builder.
META_OPS_PASSWORD=
